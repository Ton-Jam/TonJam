rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🛡️ PILLAR 0: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 🔧 Phase 3: Primitives & Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    
    // Admin check looks for an entry in /admins/ or a hardcoded bootstrap admin
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || 
        request.auth.token.email == "krusherkrupy@gmail.com"
      ); 
    }

    // 🧪 PILLAR 2: Validation Blueprints
    
    function isValidUser(data) {
      return (!data.keys().contains('uid') || (data.uid is string && data.uid.size() <= 128))
        && (!data.keys().contains('name') || (data.name is string && data.name.size() <= 200))
        && (!data.keys().contains('username') || (data.username is string && data.username.size() <= 100))
        && (!data.keys().contains('email') || (data.email is string && data.email.size() <= 256))
        && (!data.keys().contains('bio') || (data.bio is string && data.bio.size() <= 2000))
        && (!data.keys().contains('avatar') || (data.avatar is string && data.avatar.size() <= 2048));
    }

    function isValidTrack(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128))
        && (!data.keys().contains('title') || (data.title is string && data.title.size() <= 300));
    }

    function isValidNFT(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128))
        && (!data.keys().contains('title') || (data.title is string && data.title.size() <= 300));
    }

    function isValidPost(data) {
      return (!data.keys().contains('userId') || (data.userId is string && data.userId.size() <= 128))
        && (!data.keys().contains('content') || (data.content is string && data.content.size() <= 5000));
    }

    function isValidProposal(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128))
        && (!data.keys().contains('title') || (data.title is string && data.title.size() <= 300));
    }

    function isValidVote(data) {
      return (!data.keys().contains('userId') || (data.userId is string && data.userId.size() <= 128));
    }

    function isValidEvent(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128))
        && (!data.keys().contains('title') || (data.title is string && data.title.size() <= 300));
    }

    function isValidVerificationRequest(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidListing(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidPlaylistFolder(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidNotification(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidPriceAlert(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidUserMissionProgress(data) {
      return (!data.keys().contains('userId') || (data.userId is string && data.userId.size() <= 128));
    }

    function isValidOffer(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidReport(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidEqPreset(data) {
      return (!data.keys().contains('name') || (data.name is string && data.name.size() <= 100));
    }

    function isValidJamMessage(data) {
      return (!data.keys().contains('senderId') || (data.senderId is string && data.senderId.size() <= 128));
    }

    function isValidFanToken(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidAchievement(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidUserAchievement(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidUnlockedExclusiveContent(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidArtistPoll(data) {
      return (!data.keys().contains('artistId') || (data.artistId is string && data.artistId.size() <= 128));
    }

    function isValidArtistPollVote(data) {
      return (!data.keys().contains('pollId') || (data.pollId is string && data.pollId.size() <= 128));
    }

    function isValidRoyalty(data) {
      return (!data.keys().contains('artistId') || (data.artistId is string && data.artistId.size() <= 128));
    }

    function isValidCollection(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    // 🏷 MARKETPLACE LISTINGS
    match /listings/{listingId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 👤 USERS
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 🎨 ARTISTS
    match /artists/{artistId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 🎵 TRACKS
    match /tracks/{trackId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().artistId));
    }

    // 🖼 NFTS
    match /nfts/{nftId} {
      allow read: if true;
      allow create, update: if isSignedIn() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
      allow delete: if isAdmin();
    }

    // 📅 EVENTS
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().artistId));
    }

    // 🧠 POSTS & INTERACTIONS
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().userId));

      match /likes/{likeId} {
        allow read: if true;
        allow create, delete: if isSignedIn();
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn();
      }
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /follows/{followId} {
      allow read: if true;
      allow create, delete: if isSignedIn();
    }

    match /likes/{likeId} {
      allow read: if true;
      allow create, delete: if isSignedIn();
    }

    match /songRequests/{id} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /reactions/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /taskCompletions/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /verificationRequests/{requestId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /task_completions/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /proposals/{id} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();

      match /votes/{userId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    match /playlists/{playlistId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /playlistFolders/{folderId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // 💰 ROYALTIES
    match /royalties/{royaltyId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 💸 TRANSACTIONS
    match /transactions/{txId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /nftSales/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /messages/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /jamRooms/{roomId}/messages/{messageId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }
    
    match /subscriptions/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /users/{userId}/tasks/{taskId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/{userId}/eqPresets/{presetId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/{userId}/priceAlerts/{alertId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 🚀 SPONSORED CONTENT & TASKS
    match /sponsoredContent/{id} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /tasks/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /communities/{id} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 💰 TREASURY & GRANTS
    match /system/treasury {
      allow read: if true;
      allow write: if true;
    }

    match /grantAllocations/{id} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // 📡 VALIDATORS & MISSIONS
    match /validators/{validatorId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /dailyMissions/{missionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /userMissionProgress/{trackingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 🧪 CONNECTION TEST
    match /test/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 🤝 OFFERS
    match /offers/{offerId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 🚩 REPORTS
    match /reports/{reportId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 🎫 FAN TOKENS & ARTIST GOVERNANCE
    match /fanTokens/{tokenId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/{userId}/achievements/{userAchievementId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /unlockedContents/{unlockedId} {
      allow read: if true;
      allow create: if isSignedIn();
    }

    match /artistPolls/{pollId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();

      match /votes/{userId} {
        allow read: if true;
        allow create: if isSignedIn();
      }
    }
  }
}
