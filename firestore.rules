rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🛡️ PILLAR 0: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 🔧 Phase 3: Primitives & Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    
    // Admin check strictly verifies presence in /admins/ collection
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); 
    }

    // 🧪 PILLAR 2: Validation Blueprints
    
    function isValidUser(data) {
      return (!data.keys().contains('uid') || (data.uid is string && data.uid.size() <= 128))
        && (!data.keys().contains('name') || (data.name is string && data.name.size() <= 200))
        && (!data.keys().contains('username') || (data.username is string && data.username.size() <= 100))
        && (!data.keys().contains('email') || (data.email is string && data.email.size() <= 256))
        && (!data.keys().contains('bio') || (data.bio is string && data.bio.size() <= 2000))
        && (!data.keys().contains('avatar') || (data.avatar is string && data.avatar.size() <= 2048));
    }

    function isValidTrack(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128))
        && (!data.keys().contains('title') || (data.title is string && data.title.size() <= 300));
    }

    function isValidNFT(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128))
        && (!data.keys().contains('title') || (data.title is string && data.title.size() <= 300))
        && (!data.keys().contains('description') || (data.description is string && data.description.size() <= 5000))
        && (!data.keys().contains('creatorId') || (data.creatorId is string && data.creatorId.size() <= 128))
        && (!data.keys().contains('ownerId') || (data.ownerId is string && data.ownerId.size() <= 128))
        && (!data.keys().contains('imageUrl') || (data.imageUrl is string && data.imageUrl.size() <= 2048))
        && (!data.keys().contains('mediaUrl') || (data.mediaUrl is string && data.mediaUrl.size() <= 2048));
    }

    function isValidPost(data) {
      return (!data.keys().contains('userId') || (data.userId is string && data.userId.size() <= 128))
        && (!data.keys().contains('content') || (data.content is string && data.content.size() <= 5000));
    }

    function isValidProposal(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128))
        && (!data.keys().contains('title') || (data.title is string && data.title.size() <= 300));
    }

    function isValidVote(data) {
      return (!data.keys().contains('userId') || (data.userId is string && data.userId.size() <= 128));
    }

    function isValidEvent(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128))
        && (!data.keys().contains('title') || (data.title is string && data.title.size() <= 300));
    }

    function isValidVerificationRequest(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidListing(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128))
        && (!data.keys().contains('nftId') || (data.nftId is string && data.nftId.size() <= 128))
        && (!data.keys().contains('sellerId') || (data.sellerId is string && data.sellerId.size() <= 128))
        && (!data.keys().contains('status') || (data.status is string && data.status.size() <= 50))
        && (!data.keys().contains('highestBidder') || (data.highestBidder is string && data.highestBidder.size() <= 128));
    }

    function isValidBidUpdate() {
      return isSignedIn() &&
        (!existing().keys().contains('sellerId') || incoming().sellerId == existing().sellerId) &&
        (!existing().keys().contains('nftId') || incoming().nftId == existing().nftId) &&
        (incoming().highestBidder == request.auth.uid || isAdmin()) &&
        (!existing().keys().contains('sellerId') || request.auth.uid != existing().sellerId || isAdmin()) &&
        (
          !existing().keys().contains('highestBid') ||
          !(existing().highestBid is number) ||
          !(incoming().highestBid is number) ||
          incoming().highestBid > existing().highestBid
        );
    }

    function isValidPlaylistFolder(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidNotification(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidPriceAlert(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidUserMissionProgress(data) {
      return (!data.keys().contains('userId') || (data.userId is string && data.userId.size() <= 128));
    }

    function isValidOffer(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidReport(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidEqPreset(data) {
      return (!data.keys().contains('name') || (data.name is string && data.name.size() <= 100));
    }

    function isValidJamMessage(data) {
      return (!data.keys().contains('senderId') || (data.senderId is string && data.senderId.size() <= 128));
    }

    function isValidFanToken(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidAchievement(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidUserAchievement(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidUnlockedExclusiveContent(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    function isValidArtistPoll(data) {
      return (!data.keys().contains('artistId') || (data.artistId is string && data.artistId.size() <= 128));
    }

    function isValidArtistPollVote(data) {
      return (!data.keys().contains('pollId') || (data.pollId is string && data.pollId.size() <= 128));
    }

    function isValidRoyalty(data) {
      return (!data.keys().contains('artistId') || (data.artistId is string && data.artistId.size() <= 128));
    }

    function isValidCollection(data) {
      return (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128));
    }

    // 🏷 MARKETPLACE LISTINGS
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidListing(incoming()) && (
        !incoming().keys().contains('sellerId') ||
        incoming().sellerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && isValidListing(incoming()) && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes']) ||
        (
          !incoming().diff(existing()).affectedKeys().hasAny(['sellerId', 'nftId', 'nftAddress']) && (
            ('sellerId' in existing() && isOwner(existing().sellerId)) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes', 'bids', 'highestBid', 'highestBidder', 'status']) &&
              isValidBidUpdate()
            )
          )
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && 'sellerId' in existing() && isOwner(existing().sellerId));
    }

    // 👤 USERS
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin()) && (
        isAdmin() || (
          (!incoming().keys().contains('role') || incoming().role == 'collector') &&
          (!incoming().keys().contains('isAdmin') || incoming().isAdmin == false) &&
          (!incoming().keys().contains('isVerified') || incoming().isVerified == false) &&
          (!incoming().keys().contains('isVerifiedArtist') || incoming().isVerifiedArtist == false) &&
          (!incoming().keys().contains('verified') || incoming().verified == false) &&
          (!incoming().keys().contains('verificationStatus') || incoming().verificationStatus == 'unverified' || incoming().verificationStatus == 'pending') &&
          (!incoming().keys().contains('creatorPerks') || incoming().creatorPerks == null) &&
          (!incoming().keys().contains('tjBalance') || incoming().tjBalance == 0) &&
          (!incoming().keys().contains('jamBalance') || incoming().jamBalance == 0) &&
          (!incoming().keys().contains('balance') || incoming().balance == 0) &&
          (!incoming().keys().contains('earnings') || incoming().earnings == 0)
        )
      );
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && (
        isAdmin() || (
          // Non-admins CANNOT change role, isAdmin, verified flags
          !incoming().diff(existing()).affectedKeys().hasAny([
            'role', 
            'isAdmin', 
            'isVerified', 
            'isVerifiedArtist', 
            'verified', 
            'creatorPerks',
            'approvedAt',
            'resolvedAt',
            'reviewerId',
            'reviewerNotes',
            'verificationDate'
          ]) &&
          // Non-admins can only set verificationStatus to 'pending' or keep existing, NEVER directly to 'verified'
          (
            !incoming().diff(existing()).affectedKeys().hasAny(['verificationStatus']) || 
            incoming().verificationStatus == existing().verificationStatus ||
            (incoming().verificationStatus == 'pending' && existing().verificationStatus != 'verified')
          )
        )
      );
      allow delete: if isAdmin();

      // Subcollections under users/{userId} (e.g. taskState, dailyMissions, notifications, priceAlerts, searchHistory, bookmarks)
      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
    }

    // 🎨 ARTISTS
    match /artists/{artistId} {
      allow read: if true;
      allow write: if isSignedIn() && (isOwner(artistId) || isAdmin());
    }

    // 🎵 TRACKS
    match /tracks/{trackId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        !incoming().keys().contains('artistId') || 
        incoming().artistId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isSignedIn() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays', 'streams', 'likes', 'playCount', 'likeCount']) ||
        isAdmin() || 
        ('artistId' in existing() && isOwner(existing().artistId))
      );
      allow delete: if isAdmin() || (isSignedIn() && 'artistId' in existing() && isOwner(existing().artistId));
    }

    // 🖼 NFTS
    match /nfts/{nftId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidNFT(incoming()) && (
        !incoming().keys().contains('creatorId') || 
        incoming().creatorId == request.auth.uid || 
        isAdmin()
      );
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes']) ||
        (isSignedIn() && isValidNFT(incoming()) && (
          isAdmin() ||
          (
            !incoming().diff(existing()).affectedKeys().hasAny([
              'creatorId',
              'creator',
              'creatorAddress',
              'royaltyFee',
              'contractAddress',
              'id'
            ]) && (
              ('creatorId' in existing() && isOwner(existing().creatorId)) ||
              ('ownerId' in existing() && isOwner(existing().ownerId)) ||
              ('owner' in existing() && isOwner(existing().owner))
            )
          )
        ))
      );
      allow delete: if isAdmin();
    }

    // 📅 EVENTS
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        !incoming().keys().contains('artistId') || 
        incoming().artistId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isSignedIn() && (isOwner(existing().artistId) || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().artistId));
    }

    // 🧠 POSTS & INTERACTIONS
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        !incoming().keys().contains('userId') || 
        incoming().userId == request.auth.uid || 
        !incoming().keys().contains('authorId') || 
        incoming().authorId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isSignedIn() && (
        isOwner(resource.data.userId) || 
        isOwner(resource.data.authorId) || 
        isAdmin() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likesCount', 
          'repostsCount', 
          'commentsCount', 
          'sharesCount', 
          'likes', 
          'reposts', 
          'bookmarkCount', 
          'bookmarks', 
          'updatedAt'
        ])
      );
      allow delete: if isAdmin() || (isSignedIn() && (isOwner(resource.data.userId) || isOwner(resource.data.authorId)));

      match /likes/{likeId} {
        allow read: if true;
        allow create, delete: if isSignedIn() && (likeId == request.auth.uid || isAdmin());
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && (
          !incoming().keys().contains('userId') || 
          incoming().userId == request.auth.uid || 
          isAdmin()
        );
        allow update, delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      }
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        !incoming().keys().contains('userId') || 
        incoming().userId == request.auth.uid || 
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }

    match /follows/{followId} {
      allow read: if true;
      allow create, delete: if isSignedIn();
    }

    match /likes/{likeId} {
      allow read: if true;
      allow create, delete: if isSignedIn();
    }

    match /songRequests/{id} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isAdmin() ||
        (!incoming().keys().contains('creatorId') || incoming().creatorId == request.auth.uid) ||
        (!incoming().keys().contains('ownerId') || incoming().ownerId == request.auth.uid)
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (existing().keys().contains('creatorId') && isOwner(existing().creatorId)) ||
        (existing().keys().contains('ownerId') && isOwner(existing().ownerId)) ||
        (existing().keys().contains('userId') && isOwner(existing().userId))
      );
      allow delete: if isAdmin() || (
        isSignedIn() && (
          (existing().keys().contains('creatorId') && isOwner(existing().creatorId)) ||
          (existing().keys().contains('ownerId') && isOwner(existing().ownerId))
        )
      );
    }

    match /reactions/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /taskCompletions/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (!incoming().keys().contains('userId') || incoming().userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /verificationRequests/{requestId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.keys().contains('userId') && resource.data.userId == request.auth.uid)
      );
      allow create: if isSignedIn() && (
        isAdmin() || (
          incoming().userId == request.auth.uid &&
          (!incoming().keys().contains('status') || incoming().status == 'pending') &&
          !incoming().keys().contains('reviewerNotes') &&
          !incoming().keys().contains('reviewedBy') &&
          !incoming().keys().contains('reviewerId') &&
          !incoming().keys().contains('resolvedAt')
        )
      );
      allow update, delete: if isAdmin();
    }

    match /task_completions/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (!incoming().keys().contains('userId') || incoming().userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /proposals/{id} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();

      match /votes/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && (userId == request.auth.uid || isAdmin());
        allow update, delete: if false;
      }
    }

    match /playlists/{playlistId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        !incoming().keys().contains('creatorId') || 
        incoming().creatorId == request.auth.uid || 
        !incoming().keys().contains('userId') || 
        incoming().userId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isSignedIn() && (
        isOwner(existing().creatorId) || 
        isOwner(existing().userId) || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'plays', 'followers', 'tracks'])
      );
      allow delete: if isAdmin() || (isSignedIn() && (isOwner(existing().creatorId) || isOwner(existing().userId)));
    }

    match /playlistFolders/{folderId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // 💰 ROYALTIES - Creator & collaborator earnings
    match /royalties/{royaltyId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        royaltyId == request.auth.uid ||
        (resource != null && resource.data != null && (
          (resource.data.keys().contains('artistId') && resource.data.artistId == request.auth.uid) ||
          (resource.data.keys().contains('userId') && resource.data.userId == request.auth.uid)
        ))
      );
      allow create: if isSignedIn() && isValidRoyalty(incoming()) && (
        isAdmin() ||
        royaltyId == request.auth.uid ||
        (!incoming().keys().contains('artistId') || incoming().artistId == royaltyId)
      );
      allow update: if isSignedIn() && isValidRoyalty(incoming()) && (
        isAdmin() ||
        royaltyId == request.auth.uid ||
        (!incoming().keys().contains('artistId') || incoming().artistId == royaltyId)
      );
      allow delete: if isAdmin();
    }

    // 💸 TRANSACTIONS - Settlement and status transitions strictly managed by trusted backend
    match /transactions/{txId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.keys().contains('userId') && resource.data.userId == request.auth.uid) ||
        (resource.data.keys().contains('buyerId') && resource.data.buyerId == request.auth.uid) ||
        (resource.data.keys().contains('sellerId') && resource.data.sellerId == request.auth.uid) ||
        (resource.data.keys().contains('participants') && request.auth.uid in resource.data.participants)
      );
      allow create: if isSignedIn() && (
        isAdmin() || (
          (!incoming().keys().contains('userId') || incoming().userId == request.auth.uid) &&
          (!incoming().keys().contains('status') || incoming().status == 'pending' || incoming().status == 'initiated')
        )
      );
      allow update: if isAdmin();
      allow delete: if false;
    }

    // 💎 REWARD LEDGER (ROOT) - Backend only
    match /rewardLedger/{entryId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.keys().contains('userId') && resource.data.userId == request.auth.uid)
      );
      allow write: if isAdmin();
    }

    match /nftSales/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    
    match /messages/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /jamRooms/{roomId}/messages/{messageId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        !incoming().keys().contains('senderId') || 
        incoming().senderId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().senderId));
    }
    
    match /subscriptions/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /users/{userId}/tasks/{taskId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/profile/{docId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/preferences/{docId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/stats/{docId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/dailyMissionProgress/{date} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /missions/{missionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /users/{userId}/rewardLedger/{rewardId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /users/{userId}/playlists/{playlistId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/likedTracks/{trackId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/followedArtists/{artistId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/ownedNFTs/{nftId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/eqPresets/{presetId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/priceAlerts/{alertId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/searchHistory/{searchId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/listeningHistory/{historyId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 🚀 SPONSORED CONTENT & CAMPAIGNS
    match /sponsoredContent/{id} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isAdmin() || (
          (!incoming().keys().contains('userId') || incoming().userId == request.auth.uid) &&
          (!incoming().keys().contains('artistId') || incoming().artistId == request.auth.uid) &&
          (!incoming().keys().contains('status') || incoming().status == 'pending' || incoming().status == 'submitted')
        )
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /sponsoredCampaigns/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tasks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /communities/{id} {
      allow read: if true;
      allow create, update: if isSignedIn() && (
        !incoming().keys().contains('creatorId') || 
        incoming().creatorId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if isAdmin();
    }

    // 💰 TREASURY & GRANTS
    match /system/treasury {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /grantAllocations/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 📡 VALIDATORS & MISSIONS
    match /validators/{validatorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /missionTemplates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dailyMissions/{date} {
      allow read: if true;
      allow write: if isAdmin();

      match /missions/{missionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /marketplaceListings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidListing(incoming()) && (
        !incoming().keys().contains('sellerId') || 
        incoming().sellerId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isSignedIn() && isValidListing(incoming()) && (
        isAdmin() || (
          !incoming().diff(existing()).affectedKeys().hasAny(['sellerId', 'nftId', 'nftAddress']) && (
            isOwner(existing().sellerId) || 
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes']) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes', 'bids', 'highestBid', 'highestBidder', 'status']) &&
              isValidBidUpdate()
            )
          )
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().sellerId));
    }

    match /rewardConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /userMissionProgress/{trackingId} {
      allow read: if true;
      allow write: if isSignedIn() && (
        !incoming().keys().contains('userId') || 
        incoming().userId == request.auth.uid || 
        isAdmin()
      );
    }

    // 🧪 CONNECTION TEST
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 📈 TRENDING SEARCHES
    match /trendingSearches/{queryId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 🤝 OFFERS
    match /offers/{offerId} {
      allow read: if true;
      allow create, update: if isSignedIn() && (
        !incoming().keys().contains('buyerId') || 
        incoming().buyerId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 🚩 REPORTS
    match /reports/{reportId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        !incoming().keys().contains('reporterId') || 
        incoming().reporterId == request.auth.uid || 
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // 🎫 FAN TOKENS & ARTIST GOVERNANCE
    match /fanTokens/{tokenId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        isSignedIn() && (
          !incoming().keys().contains('artistId') || 
          incoming().artistId == request.auth.uid
        )
      );
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId}/achievements/{userAchievementId} {
      allow read: if true;
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /unlockedContents/{unlockedId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        !incoming().keys().contains('userId') || 
        incoming().userId == request.auth.uid || 
        isAdmin()
      );
    }

    match /artistPolls/{pollId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (
        isSignedIn() && (
          !incoming().keys().contains('artistId') || 
          incoming().artistId == request.auth.uid ||
          isOwner(existing().artistId)
        )
      );

      match /votes/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      }
    }

    // 📺 LIVE VIDEO STREAMS & REAL-TIME INTERACTION
    match /liveStreams/{streamId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        !incoming().keys().contains('artistId') || 
        incoming().artistId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isAdmin() || (
        isSignedIn() && (
          isOwner(existing().artistId) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewersCount', 'likesCount', 'status'])
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().artistId));

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isSignedIn() && (
          !incoming().keys().contains('userId') || 
          incoming().userId == request.auth.uid || 
          isAdmin()
        );
        allow update, delete: if isAdmin() || (isSignedIn() && isOwner(existing().userId));
      }

      match /tips/{tipId} {
        allow read: if true;
        allow create: if isSignedIn() && (
          !incoming().keys().contains('senderId') || 
          incoming().senderId == request.auth.uid || 
          isAdmin()
        );
        allow update, delete: if isAdmin();
      }

      match /songRequests/{requestId} {
        allow read: if true;
        allow create: if isSignedIn() && (
          !incoming().keys().contains('userId') || 
          incoming().userId == request.auth.uid || 
          isAdmin()
        );
        allow update, delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      }
    }

    // 🤝 PARTNERSHIP CONTRIBUTIONS & TRANSACTIONS
    match /partnershipContributions/{contributionId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.keys().contains('userId') && resource.data.userId == request.auth.uid)
      );
      allow create: if isSignedIn() && (
        isAdmin() || (
          (!incoming().keys().contains('userId') || incoming().userId == request.auth.uid || incoming().senderAddress != null) &&
          (!incoming().keys().contains('status') || incoming().status == 'pending' || incoming().status == 'submitted') &&
          (!incoming().keys().contains('verified') || incoming().verified == false) &&
          (!incoming().keys().contains('treasuryAddress') || incoming().treasuryAddress == 'UQD_VZD-zU7IQ4nLBDPssEzApiFbWpV6lSmkmybWxgzLFkEr')
        )
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /partnershipTxHashes/{txHash} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
